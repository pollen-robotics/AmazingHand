<?xml version="1.0"?>
<robot name="amazing_hand" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find amazing_hand_description)/urdf/amazing_hand.urdf.xacro"/>
  <xacro:arg name="namespace" default="/amazing_hand"/>
  <xacro:if value="$(arg use_sim)">
    <gazebo><plugin name="hand_control" filename="libgazebo_ros_control.so">
      <robotNamespace>$(arg namespace)</robotNamespace>
      <robotParam>robot_description</robotParam>
      <robotSimType>amazing_hand_driver/HandHWSim</robotSimType>
    </plugin></gazebo>
  </xacro:if>
  <xacro:macro name="sim_axis" params="joint">
    <transmission name="${joint}_transmission">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint}"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
      <actuator name="${joint}_actuator"><mechanicalReduction>1</mechanicalReduction></actuator>
    </transmission>
  </xacro:macro>
  <xacro:macro name="control_pair" params="name">
    <xacro:if value="$(arg use_sim)">
      <xacro:sim_axis joint="${name}_flexion_level"/>
      <xacro:sim_axis joint="${name}_abduction_level"/>
    </xacro:if>
    <xacro:unless value="$(arg use_sim)">
      <transmission name="${name}_transmission">
        <type>transmission_interface/DifferentialTransmission</type>
        <joint name="${name}_flexion_level">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <role>joint1</role>
          <mechanicalReduction>${135*pi/180}</mechanicalReduction>
          <offset>${45.0/135}</offset>
        </joint>
        <joint name="${name}_abduction_level">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <role>joint2</role>
          <mechanicalReduction>${47*pi/180}</mechanicalReduction>
          <offset>0</offset>
        </joint>
        <actuator name="${name}_motor_1">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <role>actuator1</role><mechanicalReduction>1</mechanicalReduction>
        </actuator>
        <actuator name="${name}_motor_2">
          <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
          <role>actuator2</role><mechanicalReduction>-1</mechanicalReduction>
        </actuator>
      </transmission>
    </xacro:unless>
  </xacro:macro>
  <xacro:control_pair name="index"/>
  <xacro:control_pair name="middle"/>
  <xacro:control_pair name="ring"/>
  <xacro:control_pair name="thumb"/>
</robot>
