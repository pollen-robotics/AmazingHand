<?xml version="1.0" encoding="utf-8"?>
<robot name="amazinghand" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find amazing_hand_description)/urdf/amazing_hand.urdf.xacro"/>
  <xacro:if value="$(arg use_sim)">
    <gazebo><plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find amazing_hand_driver)/config/ros2_controllers.yaml</parameters>
      <ros><namespace>$(arg namespace)</namespace></ros>
    </plugin></gazebo>
  </xacro:if>
  <xacro:arg name="port" default="/dev/ttyACM0"/>
  <xacro:arg name="baudrate" default="1000000"/>
  <xacro:arg name="serial_timeout" default="0.05"/>
  <xacro:arg name="goal_speed" default="3.0"/>
  <xacro:arg name="motor_min_deg" default="-90"/>
  <xacro:arg name="motor_max_deg" default="90"/>
  <xacro:arg name="disable_torque_on_shutdown" default="true"/>
  <ros2_control name="${hand}" type="system">
    <hardware>
      <xacro:if value="$(arg use_sim)"><plugin>gz_ros2_control/GazeboSimSystem</plugin></xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <plugin>amazing_hand_driver/AmazingHandHardwareInterface</plugin>
        <param name="port">$(arg port)</param>
        <param name="baudrate">$(arg baudrate)</param>
        <param name="serial_timeout">$(arg serial_timeout)</param>
        <param name="goal_speed">$(arg goal_speed)</param>
        <param name="motor_min_deg">$(arg motor_min_deg)</param>
        <param name="motor_max_deg">$(arg motor_max_deg)</param>
        <param name="disable_torque_on_shutdown">$(arg disable_torque_on_shutdown)</param>
      </xacro:unless>
    </hardware>
    <xacro:macro name="axis" params="name index lower">
      <joint name="${name}">
        <xacro:unless value="$(arg use_sim)">
          <param name="id">${ids[index]}</param>
          <param name="middle_deg">${middle[index]}</param>
        </xacro:unless>
        <command_interface name="position"><param name="min">${lower}</param><param name="max">1</param></command_interface>
        <state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:property name="ids" value="${[$(arg ids)]}"/>
    <xacro:property name="middle" value="${[$(arg middle)]}"/>
    <xacro:macro name="pair" params="name i">
      <xacro:axis name="${name}_flexion_level" index="${i}" lower="0"/>
      <xacro:axis name="${name}_abduction_level" index="${i+1}" lower="-1"/>
      <xacro:if value="$(arg use_sim)">
        <joint name="${hand}_${name}_flexion"><state_interface name="position"/></joint>
        <joint name="${hand}_${name}_abduction"><state_interface name="position"/></joint>
        <joint name="${hand}_${name}_distal_hinge"><state_interface name="position"/></joint>
        <joint name="${hand}_${name}_coupler_hinge"><state_interface name="position"/></joint>
      </xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <transmission name="${name}_transmission">
          <plugin>transmission_interface/DifferentialTransmission</plugin>
          <joint name="${name}_flexion_level" role="joint1"><mechanical_reduction>${135*pi/180}</mechanical_reduction><offset>${1/3}</offset></joint>
          <joint name="${name}_abduction_level" role="joint2"><mechanical_reduction>${47*pi/180}</mechanical_reduction></joint>
          <actuator name="${name}_motor_1" role="actuator1"><mechanical_reduction>1</mechanical_reduction></actuator>
          <actuator name="${name}_motor_2" role="actuator2"><mechanical_reduction>-1</mechanical_reduction></actuator>
        </transmission>
      </xacro:unless>
    </xacro:macro>
    <xacro:pair name="index" i="0"/>
    <xacro:pair name="middle" i="2"/>
    <xacro:pair name="ring" i="4"/>
    <xacro:pair name="thumb" i="6"/>
  </ros2_control>
</robot>
