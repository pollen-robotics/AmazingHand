#!/usr/bin/env python3
import argparse
from math import isfinite
from pathlib import Path

from ament_index_python.packages import get_package_share_directory
import xacro
import yaml


def calibration(side, servo_ids, middle_pos):
    default_ids = list(range(1, 9)) if side == 1 else [15, 16, 13, 14, 11, 12, 17, 18]
    ids = yaml.safe_load(servo_ids) if servo_ids else default_ids
    if (not isinstance(ids, list) or len(ids) != 8 or
            any(type(i) is not int or not 0 <= i <= 253 for i in ids) or len(set(ids)) != 8):
        raise ValueError('servo_ids must contain eight unique integers in [0,253]')
    middle = yaml.safe_load(middle_pos)
    if middle == []:
        hand = 'right_hand' if side == 1 else 'left_hand'
        path = Path.home() / '.config' / 'amazing_hand_ros' / (hand + '.yaml')
        if path.is_file():
            angles = yaml.safe_load(path.read_text())
            if not isinstance(angles, dict) or set(angles) != set(ids):
                raise ValueError(f'{path} must map the eight configured servo IDs to angles')
            middle = [angles[i] for i in sorted(ids)]
    if (not isinstance(middle, list) or len(middle) != 8 or
            any(type(v) not in (int, float) or not isfinite(v) for v in middle)):
        raise ValueError('middle_pos must contain eight finite angles in ascending servo ID order')
    return dict(ids=','.join(map(str, ids)),
                middle=','.join(str(middle[sorted(ids).index(i)]) for i in ids))


def main():
    parser = argparse.ArgumentParser()
    for name in ('side', 'servo_ids', 'middle_pos', 'control_rate', 'namespace', 'use_sim',
                 'port', 'baudrate', 'serial_timeout', 'goal_speed', 'motor_min_deg',
                 'motor_max_deg', 'disable_torque_on_shutdown'):
        parser.add_argument(name)
    args = parser.parse_args()
    side = int(args.side)
    if side not in (1, 2):
        raise ValueError('side must be 1 (right) or 2 (left)')
    rate = float(args.control_rate)
    if not rate.is_integer() or not 1 <= rate <= 1000:
        raise ValueError('control_rate must be an integer in [1,1000] Hz')
    share = Path(get_package_share_directory('amazing_hand_driver'))
    ns = args.namespace.strip('/')
    mappings = {k: getattr(args, k) for k in ('port', 'baudrate', 'serial_timeout', 'goal_speed',
                                     'motor_min_deg', 'motor_max_deg', 'disable_torque_on_shutdown')}
    mappings.update(hand_name='right_hand' if side == 1 else 'left_hand',
                    use_sim=args.use_sim.lower(), namespace='/' + ns)
    if mappings['use_sim'] == 'false':
        mappings.update(calibration(side, args.servo_ids, args.middle_pos))
    print(xacro.process_file(str(share / 'urdf/amazing_hand.urdf.xacro'),
                             mappings=mappings).toxml())


if __name__ == '__main__':
    main()
