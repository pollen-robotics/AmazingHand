<?xml version="1.0"?>
<package format="3">
  <name>amazing_hand_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 ros2_control driver for AmazingHand with normalized finger coordinates.</description>
  <maintainer email="pazeshunai@todo.todo">Shun Hasegawa</maintainer>
  <maintainer email="pazeshunai@todo.todo">Michitoshi Tsubaki</maintainer>
  <license>Apache-2.0</license>
  <build_depend>ros_environment</build_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <depend condition="$ROS_VERSION == 2">feetech_ros2_driver</depend>
  <depend condition="$ROS_VERSION == 2">transmission_interface</depend>
  <depend condition="$ROS_VERSION == 2">hardware_interface</depend>
  <depend condition="$ROS_VERSION == 2">pluginlib</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <exec_depend condition="$ROS_VERSION == 2">amazing_hand_description</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">controller_manager</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">joint_trajectory_controller</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">joint_state_broadcaster</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">robot_state_publisher</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_xml</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">ros_gz_sim</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">ros_gz_bridge</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">gz_ros2_control</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">rviz2</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">rqt_joint_trajectory_controller</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_ros</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">ament_index_python</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">xacro</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">python3-yaml</exec_depend>
  <export>
    <build_type condition="$ROS_VERSION == 1">cmake</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
